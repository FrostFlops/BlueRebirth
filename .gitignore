# ---- Build artifacts ----
**/bin/
**/obj/
.vs/
*.user
*.suo
.idea/

# ---- Python cache ----
__pycache__/
*.pyc

# ---- 本地助手记忆 / 工作区状态（仅本机，不入库）----
/.workbuddy/

# ---- Logs / dumps ----
*.log
*.dmp
*.pdb

# ---- Game clients (original binaries, NOT source) ----
/blueoath/
/苍蓝誓约/

