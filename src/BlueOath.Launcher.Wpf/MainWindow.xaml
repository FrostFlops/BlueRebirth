<Window x:Class="BlueOath.Launcher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BlueOath.Launcher.Wpf.ViewModels"
        xmlns:views="clr-namespace:BlueOath.Launcher.Wpf.Views"
        Title="BlueOath Rebirth 启动器"
        Icon="Resources/app.ico"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LaunchViewModel}">
            <views:LaunchPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GuardianViewModel}">
            <views:GuardianPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
            <views:AccountsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModViewModel}">
            <views:ModPage />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BgMediumBrush}"
                Padding="16,0"
                Height="44">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="BlueOath Rebirth"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="140,0,0,0">
                    <Button Content="启动"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="30"
                            FontSize="12"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="0"
                            Margin="0,0,4,0" />
                    <Button Content="守护"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="30"
                            FontSize="12"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="1"
                            Margin="0,0,4,0" />
                    <Button Content="账号"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="30"
                            FontSize="12"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="2"
                            Margin="0,0,4,0" />
                    <Button Content="Mod"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="30"
                            FontSize="12"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="3"
                            Margin="0,0,4,0" />
                    <Button Content="设置"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="30"
                            FontSize="12"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="4"
                            Margin="0,0,4,0" />
                </StackPanel>
                <Button Content="反馈"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Height="30"
                        FontSize="12"
                        Padding="16,0"
                        Command="{Binding OpenFeedbackCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource ErrorBrush}"
                Padding="16,8"
                Visibility="{Binding IsAntiResaleBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <TextBlock Text="⚠ 本软件永久免费，如果您付费获得了本软件，那么您已经被骗了"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Content="✕"
                        Command="{Binding HideAntiResaleBannerCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="28"
                        Height="28"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="本次启动中隐藏此提示"
                        Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    CornerRadius="4"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <ContentControl Grid.Row="2"
                        Background="{StaticResource BgDarkBrush}"
                        Content="{Binding CurrentPage}" />
    </Grid>
</Window>
